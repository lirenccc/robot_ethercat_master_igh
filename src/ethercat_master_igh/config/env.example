# IgH hard-RT env (Timing/Job ownership, safe-output, WKC/deadline/DC policies)

# Bus cycle (µs). Default 2000 = DC SYNC0 2ms（NH17/SJD17/JMDT）.
# export IGH_BUS_CYCLE_US=2000

# CPU affinity for Timing/Job threads (-1 to skip)
# export IGH_CPU_AFFINITY=5

# mlockall at Job start (production default 1)
# export IGH_LOCK_MEMORY=1

# Fail-closed if SCHED_FIFO / affinity / mlock fail (production default 1).
# Dev laptop without RT privileges: export IGH_REQUIRE_REALTIME=0
# export IGH_REQUIRE_REALTIME=1

# JobDiag to stderr every ~250 cycles
# export IGH_DEBUG_LOG=1

# Anomaly policies (WKC / deadline / DC / healthy dwell)
# export IGH_ANOMALY_WKC_CONSEC=5
# export IGH_ANOMALY_WKC_WINDOW=16
# export IGH_ANOMALY_WKC_WINDOW_STOP=8
# export IGH_ANOMALY_DEADLINE_CONSEC=10
# export IGH_ANOMALY_DEADLINE_WINDOW=32
# export IGH_ANOMALY_DEADLINE_WINDOW_STOP=16
# export IGH_ANOMALY_DC_CONSEC=5
# export IGH_ANOMALY_DC_WINDOW=16
# export IGH_ANOMALY_DC_WINDOW_STOP=8
# export IGH_DC_MONITOR_WARMUP=100
# export IGH_DC_SYNC_THRESHOLD_NS=500000
# export IGH_HEALTHY_DWELL_CYCLES=50

# External command freshness (CST; optional CSV)
# export IGH_CMD_WATCHDOG_MS=250
# export IGH_CSV_CMD_WATCHDOG=0
