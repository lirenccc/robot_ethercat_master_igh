<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ethercat_master_igh</name>
  <version>1.0.0</version>
  <description>
    External IgH EtherCAT master stack extracted for use by
    robot_rt_task_control via a thin HardwareBus adapter. Does not vendor IgH sources.
  </description>
  <maintainer email="maintainers@robot-ethercat-master.local">robot ethercat master maintainers</maintainer>
  <license>GPL-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
